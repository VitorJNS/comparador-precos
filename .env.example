# Copie este arquivo para ".env" (uso local). Na Vercel, cadastre as mesmas variáveis
# em Project Settings -> Environment Variables.

# E-mail (Gmail): crie uma "Senha de app" em https://myaccount.google.com/apppasswords
# (precisa ter a verificação em 2 etapas ativada). NÃO use sua senha normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vitorjosedonascimento2002@gmail.com
SMTP_PASS=
# Quem recebe os alertas. Vários e-mails: separe por vírgula (vão em cópia oculta).
EMAIL_PARA=vitorjosedonascimento2002@gmail.com

# Banco Neon (Postgres). Sem ela, o app local usa um Postgres embutido em data/pglite.
# Pegue em neon.tech -> seu projeto -> Connect -> "Connection string".
DATABASE_URL=

# Senha do painel. Obrigatória na Vercel (o painel fica na internet). Local: opcional.
PAINEL_SENHA=

# Segredo que protege a coleta agendada (/api/cron/*). Obrigatório na Vercel.
# Gere um valor aleatório longo, ex.: node -e "console.log(crypto.randomUUID())"
CRON_SECRET=

# Porta do painel local (http://localhost:3000)
PORT=3000
